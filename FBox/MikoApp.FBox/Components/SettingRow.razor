<IonItem Button="@(!string.IsNullOrEmpty(Href))" Detail="@(!string.IsNullOrEmpty(Href))" Href="@Href">
    <Start>@if (!string.IsNullOrEmpty(Icon)) { <IonIcon Icon="@Icon" Color="primary" /> }</Start>
    <ChildContent><IonLabel>@Label</IonLabel></ChildContent>
    <End><IonNote>@Value</IonNote></End>
</IonItem>
@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Href { get; set; }
}
