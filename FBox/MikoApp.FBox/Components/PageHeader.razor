<IonHeader>
    <IonToolbar>
        <Start><IonButtons><IonBackButton Class="back-button" DefaultHref="@BackHref" Icon="chevron-back-outline" Text="" /></IonButtons></Start>
        <ChildContent><IonTitle>@Title</IonTitle></ChildContent>
        <End><IonButtons>@Actions</IonButtons></End>
    </IonToolbar>
</IonHeader>
@code {
    [Parameter] public string Title { get; set; } = "FBox";
    [Parameter] public string BackHref { get; set; } = "/devices";
    [Parameter] public RenderFragment? Actions { get; set; }
}
