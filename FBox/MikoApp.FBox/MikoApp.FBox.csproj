<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RazorLangVersion>Latest</RazorLangVersion>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\GeneratedFiles</CompilerGeneratedFilesOutputPath>

    <!--
      Miko renders with SkiaSharp, not the browser, so the Razor SDK's web-asset
      pipeline is not used. Turn it off to avoid pulling in static web asset
      processing from transitive ASP.NET Core dependencies.
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\miko\src\Miko.Native\Miko.Native.csproj" />
    <ProjectReference Include="..\..\miko\src\Miko\Miko.csproj" />
    <ProjectReference Include="..\..\miko\src\Miko.Ionic\Miko.Ionic.csproj" />
    <ProjectReference Include="..\..\miko\src\Miko.Components\Miko.Components.csproj" />
    <EmbeddedResource Include="Assets\**\*" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNet.SignalR.Client" Version="2.4.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
