@inherits LayoutComponentBase
@namespace MikoApp.FBox
@using Miko.Routing

<IonApp Class="fbox-app">
    <IonTabs>
        <Content>
            @if (_canRenderPage) { @Body }
            else { <IonPage><IonContent /></IonPage> }
        </Content>
        <Bottom>
            @if (Store.Authenticated && IsMain)
            {
                <IonTabBar>
                    <IonTabButton Href="/devices" Selected="@(Path is "/" or "/devices")"><IonIcon Icon="list-outline" /><IonLabel>设备列表</IonLabel></IonTabButton>
                    <IonTabButton OnClick="OpenAdd"><IonIcon Icon="scan-outline" /><IonLabel>添加设备</IonLabel></IonTabButton>
                    <IonTabButton Href="/messages" Selected="@(Path == "/messages")"><IonIcon Icon="chatbox-ellipses-outline" /><IonLabel>消息中心</IonLabel></IonTabButton>
                    <IonTabButton Href="/account" Selected="@(Path == "/account")"><IonIcon Icon="person-outline" /><IonLabel>我的</IonLabel></IonTabButton>
                </IonTabBar>
            }
            @if (Store.Authenticated && IsBox)
            {
                <IonTabBar>
                    <IonTabButton OnClick="@(() => GoBox("/monitor"))" Selected="@(Path == BoxRoute("/monitor"))"><IonIcon Icon="pulse-outline" /><IonLabel>数据监控</IonLabel></IonTabButton>
                    <IonTabButton OnClick="@(() => GoBox("/alarms"))" Selected="@(Path == BoxRoute("/alarms"))"><IonIcon Icon="document-text-outline" /><IonLabel>报警记录</IonLabel></IonTabButton>
                    <IonTabButton OnClick="@(() => GoBox("/history"))" Selected="@(Path == BoxRoute("/history"))"><IonIcon Icon="time-outline" /><IonLabel>历史记录</IonLabel></IonTabButton>
                    <IonTabButton OnClick="@(() => GoBox("/remote"))" Selected="@(Path == BoxRoute("/remote"))"><IonIcon Icon="desktop-outline" /><IonLabel>远程监控</IonLabel></IonTabButton>
                    <IonTabButton OnClick="@(() => GoBox("/information"))" Selected="@(Path == BoxRoute("/information"))"><IonIcon Icon="grid-outline" /><IonLabel>更多</IonLabel></IonTabButton>
                </IonTabBar>
            }
        </Bottom>
    </IonTabs>
    <IonActionSheet @bind-IsOpen="_add" Header="添加设备" Buttons="@_addButtons" OnDidDismiss="AddDismissed" />
</IonApp>

@code {
    private string Path => "/" + (NavigationManager?.CurrentPath ?? "/").Split('?', '#')[0].Trim('/');
    private bool IsMain => Path is "/" or "/devices" or "/messages" or "/account";
    private string? BoxId => Path.Split('/') is [_, "monitor" or "alarms" or "history" or "remote" or "information", var id] ? id : null;
    private string BoxRoute(string path) => FormattableString.Invariant($"{path}/{BoxId}");
    private bool IsBox => BoxId is not null;
    private bool _add;
    private bool _canRenderPage;
    private SynchronizationContext? _context;
    private readonly IonActionSheetButton[] _addButtons = [new() { Text = "扫码添加", Data = "/scan" }, new() { Text = "序列号密码添加", Data = "/box-add" }, new() { Text = "分享码添加", Data = "/share-add" }, new() { Text = "取消", Role = "cancel" }];
    protected override void OnParametersSet() => CheckAccess();
    private void CheckAccess()
    {
        _canRenderPage = Store.Authenticated || Path is "/login" or "/register" or "/forgot-password" or "/server-settings" or "/privacy" or "/agreement";
        if (!Store.Authenticated) _add = false;
        if (!_canRenderPage)
            NavigationManager?.NavigateTo("/login", NavigationDirection.Root);
    }
    protected override void OnInitialized()
    {
        _context = SynchronizationContext.Current;
        Store.Changed += RefreshAccess;
    }
    private void RefreshAccess()
    {
        void Refresh() { CheckAccess(); StateHasChanged(); }
        if (_context is not null && SynchronizationContext.Current != _context) _context.Post(_ => Refresh(), null);
        else Refresh();
    }
    protected override void OnDispose() => Store.Changed -= RefreshAccess;
    private void OpenAdd() { _add = true; StateHasChanged(); }
    private void GoBox(string path) => NavigationManager?.NavigateTo(BoxRoute(path));
    private void AddDismissed(IonOverlayDismissEventArgs e) { if (e.Data is string path) NavigationManager?.NavigateTo(path); }
}
