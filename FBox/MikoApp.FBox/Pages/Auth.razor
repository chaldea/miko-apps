@page "/login"
@page "/register"
@page "/forgot-password"
@inherits FBoxPage

<IonPage Class="auth-page">
    @if (Login)
    {
        <IonHeader>
            <IonToolbar Class="auth-toolbar">
                <End>
                    <IonButtons>
                        <IonButton Class="auth-settings" Fill="clear" Href="/server-settings">
                            <IconOnly><IonIcon Icon="settings-outline" /></IconOnly>
                        </IonButton>
                    </IonButtons>
                </End>
            </IonToolbar>
        </IonHeader>
    }
    else { <PageHeader Title="@Title" BackHref="/login" /> }
    <IonContent>
        <div class="auth-form">
            <img class="auth-logo" src="res://Assets/login-logo.png" />
            <PageStatus />
            @if (Login && Store.Options.Demo)
            {
                <p class="auth-subtitle">演示模式 · 本地离线数据</p>
                <IonButton Class="auth-submit enter-demo" Expand="block" Shape="round" Disabled="@Store.Busy" OnClick="Demo">体验演示</IonButton>
            }
            else
            {
                <div class="auth-fields">
                    <IonInput Class="auth-user" Placeholder="@(Login ? "用户名 / 手机号 / 邮箱" : "邮箱")" @bind-Value="_user" />
                    @if (!Forgot) { <IonInput Class="auth-password" Type="password" Placeholder="密码" @bind-Value="_password" /> }
                    @if (!Forgot && !Login) { <IonInput Class="auth-confirm" Type="password" Placeholder="确认密码" @bind-Value="_confirm" /> }
                </div>
                <IonButton Class="auth-submit" Expand="block" Shape="round" Disabled="@Store.Busy" OnClick="Submit">@Title</IonButton>
                @if (Login)
                {
                    <div class="auth-links"><IonButton Fill="clear" Href="/register">用户注册</IonButton><IonButton Fill="clear" Href="/forgot-password">找回密码</IonButton></div>
                }
                else { <IonButton Fill="clear" Expand="block" Href="/login" RouterDirection="root">返回登录</IonButton> }
            }
            <IonButton Class="auth-privacy" Fill="clear" Expand="block" Href="/privacy">隐私政策</IonButton>
        </div>
    </IonContent>
</IonPage>
@code {
    private bool Login => NavigationManager?.CurrentPath == "/login";
    private bool Forgot => NavigationManager?.CurrentPath == "/forgot-password";
    private string Title => Login ? "登录" : Forgot ? "找回密码" : "注册";
    private string? _user, _password, _confirm;
    protected override void OnInitialized() { base.OnInitialized(); Store.Error = null; Store.Notice = null; }
    private async Task Demo() { if (await Run(Store.EnterDemoAsync)) GoRoot("/devices"); }
    private async Task Submit()
    {
        var ok = await Run(async () =>
        {
            if (string.IsNullOrWhiteSpace(_user)) throw new InvalidOperationException(Login ? "请输入用户名。" : "请输入邮箱。");
            if (!Login && !System.Net.Mail.MailAddress.TryCreate(_user, out _)) throw new InvalidOperationException("请输入有效邮箱地址。");
            if (!Forgot && string.IsNullOrWhiteSpace(_password)) throw new InvalidOperationException("请输入密码。");
            if (Login) await Store.LoginAsync(_user.Trim(), _password!);
            else if (Forgot) await Store.Client.PostAsync("/api/account/forgotpwdByEmail", new { email = _user }, true);
            else
            {
                if (_password!.Length < 8) throw new InvalidOperationException("密码至少需要 8 位。");
                if (_password != _confirm) throw new InvalidOperationException("两次输入的密码不一致。");
                await Store.Client.PostAsync("/api/reg/email/confirm", new { email = _user, password = _password }, true);
            }
        }, Login ? null : "请求已提交，请检查邮箱并按服务端提示继续。");
        if (ok && Login) GoRoot("/devices");
    }
}
