<Project>
  <PropertyGroup>
    <StartupType Condition="'$(StartupType)' == ''">Desktop</StartupType>
  </PropertyGroup>

  <ItemGroup Condition="$(StartupType) == 'Desktop'">
    <ProjectReference Include="..\..\miko\src\Miko.Windowing\Miko.Windowing.csproj" />
    <ProjectReference Include="..\..\miko\src\Miko.DevTools\Miko.DevTools.csproj" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup Condition="$(StartupType) == 'Android'">
    <ProjectReference Include="..\..\miko\src\Miko.Android\Miko.Android.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$(StartupType) == 'iOS'">
    <ProjectReference Include="..\..\miko\src\Miko.iOS\Miko.iOS.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$(StartupType) == 'Simulator'">
    <ProjectReference Include="..\..\miko\src\Miko.Simulator\Miko.Simulator.csproj" />
    <ProjectReference Include="..\..\miko\src\Miko.McpServer\Miko.McpServer.csproj" />
    <ProjectReference Include="..\..\miko\src\Miko.DevTools\Miko.DevTools.csproj" />
  </ItemGroup>
</Project>